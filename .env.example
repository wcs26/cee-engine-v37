# CEE Engine V37 — Variables d'environnement
# Copier en .env et remplir

# ─── Config métier ───
PRIX_CUMAC=0.00878
PRIX_CUMAC_PRECARITE=0.01523
COMMISSION_RATE=0.00

# ─── Rate limiting (req/min par IP) ───
RATE_LIMIT_AI=30
RATE_LIMIT_METIER=120
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# ─── Auth (JWT) ───
# Générer : openssl rand -hex 32
CEE_JWT_SECRET=

# ─── 5 clés IA (toutes optionnelles — l'outil fonctionne sans) ───
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# ─── Intégrations externes (stubs) ───
YOUSIGN_API_KEY=
YOUSIGN_ENV=sandbox

ERP_WEBHOOK_URL=
ERP_WEBHOOK_AUTH=

# ─── Logs ───
LOG_FORMAT=text
